{
	"name": "helia",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.33.2",
	"engines": {
		"node": "^22.12.0 || >=24.0.0",
		"pnpm": ">=10"
	},
	"scripts": {
		"dev": "vite dev",
		"dev:web": "vite dev",
		"dev:desktop": "vite dev --mode desktop",
		"build": "pnpm build:web",
		"build:web": "vite build",
		"build:desktop": "vite build --mode desktop",
		"start": "node build/web",
		"preview": "vite preview",
		"tauri": "tauri",
		"desktop:dev": "tauri dev",
		"desktop:build": "tauri build",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "vitest run",
		"test:native": "cargo test --manifest-path src-tauri/Cargo.toml --lib --no-default-features",
		"db:generate": "drizzle-kit generate"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tauri-apps/cli": "^2.12.4",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.1.8",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@lucide/svelte": "^1.66.0",
		"@tauri-apps/api": "^2.12.4",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "0.45.4"
	}
}
